{
  "slug": "smart-window",
  "version": "0.1-draft",
  "status": "validation-defaults",
  "spec": "spec/controller-kits.md",
  "vertical": "smart-window",
  "kind": "window",
  "ackSlaSec": {
    "critical": 1800,
    "warning": 7200,
    "criticalNext": 3600
  },
  "kits": [
    "kit-win-act",
    "kit-env-node"
  ],
  "channels": [
    {
      "key": "position_pct",
      "label": "position_pct",
      "labelKey": "channel.position_pct",
      "unit": "%",
      "sampleSec": 5,
      "kind": "numeric"
    },
    {
      "key": "rain",
      "label": "rain",
      "labelKey": "channel.rain",
      "unit": "1",
      "sampleSec": 60,
      "kind": "bool"
    },
    {
      "key": "temperature",
      "label": "temperature",
      "labelKey": "channel.temperature",
      "unit": "°C",
      "sampleSec": 60,
      "kind": "numeric"
    },
    {
      "key": "limit_open",
      "label": "limit_open",
      "labelKey": "channel.limit_open",
      "unit": "1",
      "sampleSec": 5,
      "kind": "bool"
    },
    {
      "key": "limit_close",
      "label": "limit_close",
      "labelKey": "channel.limit_close",
      "unit": "1",
      "sampleSec": 5,
      "kind": "bool"
    }
  ],
  "commands": [
    {
      "id": "open",
      "labelKey": "command.open",
      "method": "open",
      "rollbackId": "stop"
    },
    {
      "id": "close",
      "labelKey": "command.close",
      "method": "close",
      "rollbackId": "stop"
    },
    {
      "id": "stop",
      "labelKey": "command.stop",
      "method": "stop"
    },
    {
      "id": "setPosition",
      "labelKey": "command.setPosition",
      "method": "setPosition",
      "param": "pct",
      "min": 0,
      "max": 100
    }
  ],
  "policy": {
    "rainClose": true,
    "heatVentC": 28,
    "ventPct": 30
  },
  "simulate": [
    {
      "id": "overtemp",
      "label": "超温",
      "labelKey": "sim.scenario.overtemp",
      "alarmType": "Temperature High",
      "severity": "WARNING",
      "telemetry": {
        "temperature": 32,
        "rain": 0,
        "position_pct": 80,
        "limit_open": 0,
        "limit_close": 0
      }
    },
    {
      "id": "heatVent",
      "label": "高温开缝",
      "labelKey": "sim.scenario.heatVent",
      "alarmType": "Temperature High",
      "severity": "WARNING",
      "telemetry": {
        "temperature": 32,
        "rain": 0,
        "position_pct": 30,
        "limit_open": 0,
        "limit_close": 0
      }
    },
    {
      "id": "rain",
      "label": "降雨关窗",
      "labelKey": "sim.scenario.rain",
      "alarmType": "Rain Close",
      "severity": "WARNING",
      "telemetry": {
        "temperature": 22,
        "rain": 1,
        "position_pct": 80
      }
    },
    {
      "id": "normal",
      "label": "晴好",
      "labelKey": "sim.scenario.normal",
      "telemetry": {
        "temperature": 24,
        "rain": 0,
        "position_pct": 0
      }
    }
  ],
  "scenes": [
    {
      "id": "win-manual",
      "packSlug": "smart-window",
      "kitSlug": "kit-win-act",
      "mode": "manual",
      "enabled": true,
      "triggers": [
        {
          "type": "command"
        }
      ],
      "actions": [
        {
          "commandId": "open"
        }
      ]
    },
    {
      "id": "win-rain-close",
      "packSlug": "smart-window",
      "kitSlug": "kit-win-act",
      "mode": "policy",
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "key": "rain",
          "op": "eq",
          "value": 1
        }
      ],
      "actions": [
        {
          "commandId": "close"
        }
      ]
    },
    {
      "id": "win-heat-vent",
      "packSlug": "smart-window",
      "kitSlug": "kit-win-act",
      "mode": "policy",
      "enabled": true,
      "triggers": [
        {
          "type": "threshold",
          "key": "temperature",
          "op": "gte",
          "value": 28
        }
      ],
      "actions": [
        {
          "commandId": "setPosition",
          "params": {
            "pct": 30
          }
        }
      ],
      "safety": {
        "interlocks": [
          {
            "when": {
              "rain": 1
            },
            "deny": [
              "setPosition",
              "open"
            ]
          }
        ]
      }
    },
    {
      "id": "win-ai-weather",
      "packSlug": "smart-window",
      "kitSlug": "kit-win-act",
      "mode": "ai",
      "enabled": true,
      "triggers": [
        {
          "type": "ai"
        }
      ],
      "actions": [
        {
          "commandId": "setPosition"
        }
      ],
      "safety": {
        "requireEvidence": [
          "temperature",
          "rain"
        ]
      }
    }
  ],
  "safetyEnvelope": {
    "allowlist": [
      "open",
      "close",
      "stop",
      "setPosition"
    ],
    "maxPerHour": 60,
    "requireEvidence": [
      "limit_open",
      "limit_close"
    ]
  },
  "reportColumns": [
    "site",
    "period",
    "packVersion",
    "commands",
    "denials"
  ],
  "permissions": [
    "iot.incident:view",
    "iot.command:dispatch",
    "iot.controller:view",
    "iot.scene:manage"
  ],
  "artifacts": {
    "deviceProfile": "device-profile.window.json",
    "ruleChain": "rule-chain.json",
    "ruleChainMetadata": "rule-chain-metadata.json"
  }
}
