{
  "slug": "cold-lab",
  "version": "0.1-draft",
  "status": "validation-defaults",
  "spec": "spec/industry-pack.md",
  "kinds": [
    "fridge",
    "freezer_20",
    "freezer_80",
    "cold_room",
    "gateway"
  ],
  "excludedKinds": [
    "incubator"
  ],
  "channels": {
    "temperature": {
      "unit": "Cel",
      "sampleIntervalSec": 60,
      "openAfterSamples": 2,
      "labelKey": "channel.temperature"
    },
    "door": {
      "unit": "1",
      "heartbeatSec": 60,
      "edge": true,
      "labelKey": "channel.door"
    },
    "power": {
      "unit": "1",
      "heartbeatSec": 60,
      "edge": true,
      "labelKey": "channel.power"
    },
    "gateway_online": {
      "unit": "1",
      "sampleIntervalSec": 60,
      "labelKey": "channel.gateway"
    }
  },
  "policy": {
    "temperatureWindows": {
      "fridge": {
        "minC": 2,
        "maxC": 8,
        "warnBandC": 0.5,
        "criticalAfterSec": 180
      },
      "freezer_20": {
        "minC": -25,
        "maxC": -15,
        "warnBandC": 1,
        "criticalAfterSec": 180
      },
      "freezer_80": {
        "minC": -86,
        "maxC": -70,
        "warnBandC": 2,
        "criticalAfterSec": 180
      },
      "cold_room": {
        "minC": null,
        "maxC": null,
        "note": "required-at-site-onboarding"
      }
    },
    "doorOpenTimeoutSec": 180,
    "doorOpenTimeoutColdRoomSec": 300,
    "gatewayOfflineSec": 180,
    "powerLoss": {
      "severity": "critical",
      "openImmediately": true
    },
    "dedupeOpenIncidentPerChannel": true
  },
  "ackSlaSec": {
    "critical": 600,
    "warning": 1800
  },
  "escalate": {
    "critical": [
      "facilities",
      "qa_owner"
    ],
    "warning": [
      "facilities"
    ]
  },
  "kits": [
    "kit-env-node",
    "kit-rly-4ch"
  ],
  "commands": [
    {
      "id": "setTemperatureSetpoint",
      "labelKey": "command.setTemperatureSetpoint",
      "method": "setTemperatureSetpoint",
      "param": "setpointC",
      "min": -86,
      "max": 15
    },
    {
      "id": "ping",
      "labelKey": "command.ping",
      "method": "ping"
    }
  ]
}
