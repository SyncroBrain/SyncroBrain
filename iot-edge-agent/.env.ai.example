# Copy to iot-edge-agent/.env.ai and fill in local keys.
# Never commit .env.ai — it is gitignored.

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_TRACKING_ID=

# Gemini
GEMINI_API_KEY=
GEMINI_PROJECT_NAME=

# 智谱大模型
BIG_MODEL_API_KEY=
BIG_MODEL_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# 豆包
DOUBAO_API_KEY=
DOUBAO_NANE=
DOUBAO_DEEPSEEK_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# 千问（填兼容模式 Base URL；不要提交租户专属网关）
QIANWEN_API_KEY=
QIANWEN_BASE_URL=

# Kimi
KIMI_API_KEY=
