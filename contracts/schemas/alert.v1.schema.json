{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncrobrain.com/schemas/alert.v1.schema.json",
  "title": "AlertEvent",
  "description": "Vendored VistaCast alert.v1. Cross-product events only; no raw video. Care payloads must not travel on MQTT.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "tenantId", "occurredAt", "kind", "severity", "state"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "alert.v1" },
    "id": { "type": "string", "format": "uuid" },
    "tenantId": { "type": "string", "format": "uuid" },
    "siteId": { "type": "string", "format": "uuid" },
    "cameraId": { "type": "string", "format": "uuid" },
    "ruleId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "kind": {
      "type": "string",
      "enum": [
        "intrusion",
        "footfall.threshold",
        "device.offline",
        "device.online",
        "device.stream_degraded",
        "rule.custom",
        "fall",
        "fight",
        "smoke",
        "face.stranger",
        "staff.away",
        "staff.phone"
      ]
    },
    "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
    "state": { "type": "string", "enum": ["open", "acknowledged", "false_positive", "resolved"] },
    "dedupKey": { "type": "string" },
    "title": { "type": "string", "maxLength": 200 },
    "payload": {
      "type": "object",
      "description": "Structured extras. Optional syncrobrainDeviceId, drill. Never raw video.",
      "additionalProperties": true
    },
    "clipRef": { "type": "string" },
    "idempotencyKey": { "type": "string" },
    "care": {
      "type": "object",
      "additionalProperties": false,
      "required": ["householdId", "incidentId", "stage"],
      "properties": {
        "householdId": { "type": "string", "format": "uuid" },
        "incidentId": { "type": "string", "format": "uuid" },
        "stage": {
          "type": "string",
          "enum": ["candidate", "awaiting_confirmation", "cancelled", "escalated", "reviewed", "closed"]
        },
        "cascadeStep": { "type": "string", "enum": ["child", "neighbor", "partner_care"] },
        "confirmationWindowSec": { "type": "integer", "minimum": 30, "maximum": 60 }
      }
    }
  }
}
