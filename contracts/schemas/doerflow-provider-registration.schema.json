{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncrobrain.com/schemas/doerflow-provider-registration.schema.json",
  "title": "DoerFlow provider registration",
  "description": "Unified seller registration. productCode is always syncrobrain. Not a telemetry bus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "productCode",
    "offeringCode",
    "idempotencyKey",
    "sourceTenantId",
    "pricingUnit",
    "readiness",
    "endpointUrl",
    "unitPrice",
    "payee"
  ],
  "properties": {
    "name": { "type": "string" },
    "productCode": { "type": "string", "const": "syncrobrain" },
    "offeringCode": {
      "type": "string",
      "enum": [
        "syncrobrain.telemetry-digest.v1",
        "syncrobrain.incident-report.v1"
      ]
    },
    "sourceTenantId": { "type": "string", "minLength": 1 },
    "pricingUnit": { "type": "string", "enum": ["window", "batch"] },
    "readiness": { "type": "string", "enum": ["lab", "production", "disabled"] },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "endpointUrl": { "type": "string", "format": "uri" },
    "unitPrice": { "type": "string" },
    "payee": { "type": "string", "minLength": 1 }
  }
}
