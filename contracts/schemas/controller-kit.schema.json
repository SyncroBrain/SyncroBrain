{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncrobrain.com/schemas/controller-kit.schema.json",
  "title": "SyncroBrain Controller Kit",
  "type": "object",
  "required": ["slug", "version", "mcuClass", "bindPaths", "channels", "commands"],
  "additionalProperties": true,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^kit-[a-z][a-z0-9-]{1,48}$"
    },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "titleKey": { "type": "string" },
    "summary": { "type": "string" },
    "mcuClass": {
      "type": "string",
      "enum": ["esp32", "edge-agent", "plc"]
    },
    "bindPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["official", "protocol"] }
    },
    "protocols": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["mqtt-tb", "modbus-tcp", "modbus-rtu", "opcua", "gps"]
      }
    },
    "io": {
      "type": "object",
      "properties": {
        "outputs": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": { "type": "string" },
          "kind": { "type": "string", "enum": ["numeric", "bool", "enum", "geo"] },
          "unit": { "type": "string" },
          "required": { "type": "boolean" },
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "method": { "type": "string" },
          "params": { "type": "array", "items": { "type": "string" } },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "rollbackId": { "type": "string" }
        }
      }
    },
    "safetyEnvelope": {
      "type": "object",
      "properties": {
        "allowlist": { "type": "array", "items": { "type": "string" } },
        "maxOnSec": { "type": "integer", "minimum": 0 },
        "dryRunSec": { "type": "integer", "minimum": 0 },
        "requireEvidence": { "type": "array", "items": { "type": "string" } },
        "interlocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": { "type": "object" },
              "deny": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "bom": {
      "type": "object",
      "properties": {
        "principle": { "type": "string" },
        "mcu": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
