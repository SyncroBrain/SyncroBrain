{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncrobrain.com/schemas/scene.schema.json",
  "title": "SyncroBrain scene recipe",
  "type": "object",
  "required": ["id", "packSlug", "kitSlug", "mode", "triggers", "actions"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "packSlug": { "type": "string" },
    "kitSlug": { "type": "string" },
    "mode": { "type": "string", "enum": ["manual", "policy", "ai"] },
    "enabled": { "type": "boolean" },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["command", "threshold", "schedule", "ai", "external_event"]
          },
          "commandId": { "type": "string" },
          "key": { "type": "string" },
          "op": { "type": "string", "enum": ["lt", "lte", "gt", "gte", "eq"] },
          "value": { "type": ["number", "integer", "boolean"] },
          "windowCron": { "type": "string" },
          "source": { "type": "string", "description": "external_event source product, e.g. vistacast" },
          "schema": { "type": "string", "description": "external_event schema id, e.g. alert.v1" },
          "kind": { "type": "string" },
          "state": { "type": "string" }
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["commandId"],
        "properties": {
          "commandId": { "type": "string" },
          "params": { "type": "object" }
        }
      }
    },
    "safety": {
      "type": "object",
      "properties": {
        "maxOnSec": { "type": "integer" },
        "requireEvidence": { "type": "array", "items": { "type": "string" } },
        "interlocks": { "type": "array" }
      }
    }
  }
}
