{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncrobrain.com/schemas/pack-manifest.schema.json",
  "title": "SyncroBrain Industry Pack Manifest",
  "type": "object",
  "required": ["slug", "version", "kind", "artifacts"],
  "additionalProperties": true,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "titleKey": { "type": "string" },
    "description": { "type": "string" },
    "vertical": {
      "type": "string",
      "enum": [
        "cold-lab",
        "cold-food",
        "cold-logistics",
        "ev-charging",
        "energy-storage",
        "industrial-sensor",
        "demo"
      ]
    },
    "kind": { "type": "string", "minLength": 1 },
    "assetKinds": { "type": "array", "items": { "type": "string" } },
    "profileName": { "type": "string" },
    "localeKeys": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "object",
      "required": ["deviceProfile", "ruleChain", "ruleChainMetadata"],
      "properties": {
        "deviceProfile": { "type": "string" },
        "ruleChain": { "type": "string" },
        "ruleChainMetadata": { "type": "string" }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "labelKey": { "type": "string" },
          "unit": { "type": "string" },
          "sampleSec": { "type": "number" },
          "note": { "type": "string" },
          "kind": { "type": "string", "enum": ["numeric", "bool", "enum", "geo"] }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "labelKey": { "type": "string" },
          "unit": { "type": "string" },
          "display": { "type": "string", "enum": ["numeric", "bool", "enum"] },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "warnBand": { "type": "number" },
          "alarmHigh": { "type": "number" },
          "alarmLow": { "type": "number" },
          "trueLabel": { "type": "string" },
          "falseLabel": { "type": "string" },
          "trueStatus": { "type": "string", "enum": ["ok", "warn", "alarm"] }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "method": { "type": "string" },
          "param": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "rollbackId": { "type": "string" }
        }
      }
    },
    "simulate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "telemetry"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "alarmType": { "type": "string" },
          "severity": { "type": "string" },
          "telemetry": { "type": "object", "additionalProperties": { "type": "number" } }
        }
      }
    },
    "safetyEnvelope": {
      "type": "object",
      "properties": {
        "allowlist": { "type": "array", "items": { "type": "string" } },
        "maxPerHour": { "type": "integer", "minimum": 0 },
        "requireEvidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "policy": { "type": "object" },
    "summary": { "type": "object" },
    "reportColumns": { "type": "array", "items": { "type": "string" } },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "adapters": { "type": "object" }
  }
}
